---
import type { EventForm } from "../../data/events";
import { site } from "../../data/site";
import LeadForm from "../LeadForm.astro";
import MapFacade from "../MapFacade.astro";
import FactIcon from "./FactIcon.astro";
import ReviewBand from "../ReviewBand.astro";
import { media } from "./media";

interface Props {
  event: EventForm;
}
const { event } = Astro.props;
const left = media("media/2025-12-IMG_2339-768x576.jpeg.webp");
const right = media("media/2025-12-IMG_2342-768x576.jpeg.webp");
---

<section class="b2-block">
  <div class="b2-wrap contact-grid">
    <div class="contact-copy">
      <h2>Contact Us</h2>
      <p>We look forward to hearing from you! <br />We are located one block west of Campbell off Plainview Road (Farm Road 182), directly behind the Eagles Lodge next to Marco Automotive. Look for the grey building!</p>
      <p class="b2-fact contact-fact">
        <FactIcon name="pin" />
        <span class="b2-fact-text">{site.address.display}</span>
      </p>
      <p class="b2-fact contact-fact">
        <FactIcon name="phone" />
        <span class="b2-fact-text"><a href={site.phone.tel}>(417)894-7319</a></span>
      </p>
      <p class="b2-fact contact-fact">
        <FactIcon name="mail" />
        <span class="b2-fact-text"><a href={`mailto:${site.email}`}>{site.email}</a></span>
      </p>
      <LeadForm event={event} tone="card" />
    </div>
    <div class="contact-map">
      <MapFacade />
    </div>
  </div>
</section>

<ReviewBand
  title="Client Testimonials"
  sub="What Our Clients Say"
  text="We had our son’s 10th birthday here. All of the kids had a great time. They set up an obstacle course for the kids. They loved the whole experience. The favorite was the curved wall to run up. That was everyone’s challenge for the night. We will be visiting again for sure."
  by="- Jennifer L."
/>

<section class="b2-block">
  <div class="b2-wrap contact-photos">
    {left.src && <img src={left.src} alt="" width="547" height="410" />}
    {right.src && <img src={right.src} alt="" width="547" height="410" />}
  </div>
</section>

<ReviewBand
  text="My daughter started training here 3 years ago at 8, and she still loves it!! Owner and coaching staff are all super encouraging. We live an hour away but make the drive twice a week as often as possible. Training here has not only helped her get stronger physically but increased her confidence in general. Anything that makes kids want to challenge themselves to get better and better is worth it!"
  by="- Lee C."
/>
