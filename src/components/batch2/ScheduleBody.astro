---
import type { EventForm } from "../../data/events";
import LeadForm from "../LeadForm.astro";
import ReviewBand from "../ReviewBand.astro";

interface Props {
  event: EventForm;
}
const { event } = Astro.props;
---

<section class="book-plain">
  <div class="book-wrap">
    <h1>Book a Birthday Party</h1>
    <ol class="book-steps">
      <li>1. Fill out the form to begin the scheduling process and check availability</li>
      <li>2. We will secure a date and then follow up with a phone call to confirm details and collect the $179 fee</li>
      <li>3. Look forward to the best birthday ever!</li>
    </ol>
    <LeadForm event={event} />
  </div>
</section>
<ReviewBand
  title="Client Testimonials"
  sub="What Our Clients Say"
  text="We had our son’s 10th birthday here. All of the kids had a great time. They set up an obstacle course for the kids. They loved the whole experience. The favorite was the curved wall to run up. That was everyone’s challenge for the night. We will be visiting again for sure."
  by="- Jennifer L."
/>

<style>
  .book-plain {
    padding: 12px 0 8px;
  }
  .book-wrap {
    box-sizing: border-box;
    width: min(var(--content-max), calc(100% - var(--content-pad) * 2));
    margin: 0 auto;
  }
  h1 {
    margin: 0 0 8px;
    color: #285276;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 32px;
    font-weight: 800;
    line-height: 1.15;
  }
  .book-steps {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }
  .book-steps li {
    margin: 0;
    color: #171716;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.35;
  }
</style>
