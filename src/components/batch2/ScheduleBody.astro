---
import type { EventForm } from "../../data/events";
import LeadForm from "../LeadForm.astro";
import Quotes from "./Quotes.astro";

interface Props {
  event: EventForm;
}
const { event } = Astro.props;
---

<section class="b2-block b2-grey">
  <div class="b2-wrap bd-steps">
    <p class="bd-steps-p">1. Fill out the form to begin the scheduling process and check availability 2. We will secure a date and then follow up with a phone call to confirm details and collect the $179 fee 3. Look forward to the best birthday ever!</p>
    <p class="bd-req"><span>"</span><span class="bd-star">*</span><span>" indicates required fields</span></p>
    <LeadForm event={event} />
  </div>
</section>
<Quotes variant="schedule" as="h1" />
