---
import { site } from "../data/site";
---

<section class="final-cta" aria-label="Try open gym">
  <div class="final-inner">
    <h2>Be an Everyday Warrior!</h2>
    <p>If you’re looking for a unique and fun way to get active, you can come in at any time during our open hours and have a great time getting fit!</p>
    <div class="actions">
      <a class="go" href="https://square.link/u/GmmQ7iuL">TRY OPEN GYM FOR $10</a>
      <a class="call" href={site.phone.tel}>{site.phone.display}</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: #285276;
    color: #fff;
    padding: 48px 0;
  }
  .final-inner {
    box-sizing: border-box;
    width: min(var(--content-max), calc(100% - var(--content-pad) * 2));
    margin: 0 auto;
  }
  h2 {
    margin: 0 0 12px;
    color: #fff;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.1;
    text-transform: none;
  }
  p {
    margin: 0 0 20px;
    max-width: 62ch;
    color: #fff;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 18px;
    line-height: 1.5;
  }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 999px;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-weight: 800;
    text-decoration: none;
  }
  .go { background: #d6352f; color: #fff; }
  .call { background: #fff; color: #285276; }
</style>
