---
import type { EventForm, FormField } from "../data/events";
import { site } from "../data/site";

interface Props {
  event: EventForm;
}
const { event } = Astro.props;
const phone = site.phone;
let messageUsed = false;

function childKey(field: FormField): string {
  const label = field.label.toLowerCase();
  if (label.startsWith("gender")) return "gender";
  if (label.startsWith("birthday")) return "birthday";
  if (label.startsWith("age division") || label.startsWith("division")) return "division";
  return "name";
}

function isMessage(field: FormField): boolean {
  if (field.kind !== "textarea" || messageUsed) return false;
  messageUsed = true;
  return true;
}
---

<form class="form-card" id={event.anchor} data-lead-form data-event-id={event.id} data-form-key={event.formKey} data-event-name={event.event} data-success-type={event.success.type} data-success-value={event.success.type === "redirect" ? event.success.path : event.success.message} data-button-label={event.button} novalidate>
  {
    event.fields.map((field) => {
      const id = `${event.id}-${field.name || field.kind}`;
      const part = field.namePart || (field.label === "First Name" ? "first" : field.label === "Last Name" ? "last" : undefined);
      if (field.kind === "name" || part === "first" || part === "last") {
        if (part === "last") return null;
        if (part === "first") {
          return (
            <div class="name-row">
              <div>
                <label for={`${event.id}-first`}>{field.label}</label>
                <input id={`${event.id}-first`} name="first" type="text" autocomplete="given-name" maxlength="100" required={field.required} data-role="first" />
              </div>
              <div>
                <label for={`${event.id}-last`}>Last Name</label>
                <input id={`${event.id}-last`} name="last" type="text" autocomplete="family-name" maxlength="100" required data-role="last" />
              </div>
            </div>
          );
        }
        return (
          <div>
            <span class="label">{field.label}{field.required ? " *" : ""}</span>
            <div class="name-row">
              <div>
                <label for={`${event.id}-first`}>First</label>
                <input id={`${event.id}-first`} name="first" type="text" autocomplete="given-name" maxlength="100" required={field.required} data-role="first" />
              </div>
              <div>
                <label for={`${event.id}-last`}>Last</label>
                <input id={`${event.id}-last`} name="last" type="text" autocomplete="family-name" maxlength="100" required={field.required} data-role="last" />
              </div>
            </div>
          </div>
        );
      }
      if (field.kind === "checkbox" || field.kind === "radio") {
        return (
          <fieldset data-extra-key={field.name} data-extra-label={field.label} data-extra-kind={field.kind} data-required={field.required ? "true" : "false"}>
            <legend class="label">{field.label}{field.required ? " *" : ""}</legend>
            <div class="check-grid">
              {(field.choices || []).map((choice) => (
                <label>
                  <input type={field.kind === "radio" ? "radio" : "checkbox"} name={`${event.id}-${field.name}`} value={choice} />
                  <span>{choice}</span>
                </label>
              ))}
            </div>
          </fieldset>
        );
      }
      if (field.kind === "select") {
        return (
          <div>
            <label for={id}>{field.label}{field.required ? " *" : ""}</label>
            <select id={id} name={field.name} required={field.required} data-role="extra" data-extra-key={field.name} data-extra-label={field.label}>
              <option value="">Select</option>
              {(field.choices || []).map((choice) => <option value={choice}>{choice}</option>)}
            </select>
          </div>
        );
      }
      const role = field.kind === "email" ? "email" : field.kind === "phone" ? "phone" : isMessage(field) ? "message" : "extra";
      const type = field.kind === "email" ? "email" : field.kind === "phone" ? "tel" : field.kind === "date" ? "date" : "text";
      return (
        <div>
          <label for={id}>{field.label}{field.required ? " *" : ""}</label>
          {field.kind === "textarea" ? (
            <textarea id={id} name={field.name} maxlength="5000" required={field.required} data-role={role} data-extra-key={field.name} data-extra-label={field.label} />
          ) : (
            <input id={id} name={field.name} type={type} maxlength={field.kind === "email" ? 320 : 500} required={field.required} autocomplete={field.kind === "email" ? "email" : field.kind === "phone" ? "tel" : "on"} data-role={role} data-extra-key={field.name} data-extra-label={field.label} />
          )}
        </div>
      );
    })
  }
  {
    event.repeater && (
      <div data-repeater data-max={event.repeater.max}>
        <div class="child-card" data-child>
          <p class="label">Competitor 1</p>
          {event.repeater.fields.map((field) => {
            const key = childKey(field);
            const id = `${event.id}-child-${key}`;
            if (field.kind === "name") {
              return (
                <div>
                  <label for={id}>{field.label}</label>
                  <input id={id} type="text" maxlength="200" data-child-field="name" required={field.required} />
                </div>
              );
            }
            if (field.kind === "radio") {
              return (
                <fieldset>
                  <legend class="label">{field.label}</legend>
                  <div class="check-grid">
                    {(field.choices || []).map((choice) => (
                      <label>
                        <input type="radio" name={`${event.id}-child-${key}`} value={choice} data-child-field={key} />
                        <span>{choice}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              );
            }
            return (
              <div>
                <label for={id}>{field.label}</label>
                <input id={id} type={field.kind === "date" ? "date" : "text"} data-child-field={key} required={field.required} />
              </div>
            );
          })}
          <button class="btn" type="button" data-remove hidden>{event.repeater.removeLabel}</button>
        </div>
        <p><button class="btn" type="button" data-add>{event.repeater.addLabel}</button></p>
      </div>
    )
  }
  <div class="hp" aria-hidden="true">
    <label for={`${event.id}-hp`}>Website</label>
    <input id={`${event.id}-hp`} name="website_url" type="text" tabindex="-1" autocomplete="off" data-role="honeypot" />
  </div>
  <button class="btn" type="submit" disabled data-submit>Form loading… or call {phone.display}</button>
  <p class="form-status" role="status" aria-live="polite" data-status></p>
  <noscript>
    <p>Form loading… or call <a href={phone.tel}>{phone.display}</a>.</p>
  </noscript>
</form>

<script>
  import { SubmissionAttempt, hasContactMethod, resolveEndpoint, submitLead, type ChildRow, type ExtraField, type FieldValues } from "../lib/forms";
  import { site } from "../data/site";

  const phone = site.phone;

  document.querySelectorAll<HTMLFormElement>("[data-lead-form]").forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const status = form.querySelector<HTMLElement>("[data-status]");
    if (!submit || !status) return;
    const attempt = new SubmissionAttempt();
    let startedAt = Date.now();
    form.addEventListener("input", () => { startedAt = startedAt || Date.now(); }, { once: true });

    const say = (text: string, kind: "ok" | "error" | "info", withPhone = false) => {
      status.textContent = text;
      status.dataset["kind"] = kind;
      if (withPhone) {
        status.append(" ");
        const link = document.createElement("a");
        link.href = phone.tel;
        link.textContent = phone.display;
        status.append(link, ".");
      }
    };

    const read = (role: string) => (form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-role="${role}"]`)?.value ?? "");

    const extras = (): ExtraField[] => {
      const list: ExtraField[] = [];
      form.querySelectorAll<HTMLElement>("[data-extra-key]").forEach((node) => {
        if (node.closest("[data-child]")) return;
        const key = node.dataset["extraKey"] || "field";
        const label = node.dataset["extraLabel"] || key;
        if (node instanceof HTMLInputElement || node instanceof HTMLTextAreaElement || node instanceof HTMLSelectElement) {
          if (node.dataset["role"] === "message" || node.dataset["role"] === "email" || node.dataset["role"] === "phone") return;
          if (node.value.trim()) list.push({ key, label, value: node.value });
          return;
        }
        const chosen = [...node.querySelectorAll<HTMLInputElement>("input:checked")].map((input) => input.value);
        if (chosen.length) list.push({ key, label, value: chosen.join(", ") });
      });
      return list;
    };

    const children = (): ChildRow[] =>
      [...form.querySelectorAll<HTMLElement>("[data-child]")].map((row) => {
        const val = (key: string) => {
          const fields = [...row.querySelectorAll<HTMLInputElement>(`[data-child-field="${key}"]`)];
          const picked = fields.find((field) => field.type !== "radio" || field.checked);
          return picked?.value ?? "";
        };
        return { name: val("name"), gender: val("gender"), birthday: val("birthday"), division: val("division") };
      });

    const repeater = form.querySelector<HTMLElement>("[data-repeater]");
    const add = form.querySelector<HTMLButtonElement>("[data-add]");
    add?.addEventListener("click", () => {
      if (!repeater) return;
      const rows = repeater.querySelectorAll("[data-child]");
      const max = Number(repeater.dataset["max"] || "4");
      const source = rows[0];
      if (rows.length >= max || !source) return;
      const clone = source.cloneNode(true) as HTMLElement;
      clone.querySelectorAll("input").forEach((input) => {
        if (input.type === "radio" || input.type === "checkbox") input.checked = false;
        else input.value = "";
        if (input.name) input.name = `${input.name}-${rows.length}`;
      });
      const label = clone.querySelector("p");
      if (label) label.textContent = `Competitor ${rows.length + 1}`;
      const remove = clone.querySelector<HTMLButtonElement>("[data-remove]");
      if (remove) remove.hidden = false;
      repeater.insertBefore(clone, add.parentElement);
    });
    repeater?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement) || !target.matches("[data-remove]")) return;
      const rows = repeater.querySelectorAll("[data-child]");
      if (rows.length < 2) return;
      target.closest("[data-child]")?.remove();
    });

    submit.disabled = false;
    submit.textContent = form.dataset["buttonLabel"] || "Submit";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      const values: FieldValues = {
        first: read("first"),
        last: read("last"),
        email: read("email"),
        phone: read("phone"),
        message: read("message"),
        honeypot: read("honeypot"),
        extras: extras(),
        children: children(),
      };
      const missingChoice = [...form.querySelectorAll<HTMLElement>("[data-required='true']")].some((group) => !group.querySelector("input:checked"));
      if (missingChoice || !form.checkValidity()) {
        form.reportValidity();
        say("Please check the required fields, or call", "error", true);
        return;
      }
      if (!hasContactMethod(values) && form.dataset["formKey"] !== "event-waitlist" && !values.email.trim()) {
        say("Please add a phone number or email, or call", "error", true);
        return;
      }
      if (resolveEndpoint(location.hostname).kind === "none") {
        say(`This preview cannot send the form. Please call ${phone.display}.`, "info");
        const link = document.createElement("a");
        link.href = phone.tel;
        link.textContent = phone.display;
        status.textContent = "This preview cannot send the form. Please call ";
        status.append(link, ".");
        return;
      }
      submit.disabled = true;
      say("Sending…", "info");
      const result = await submitLead(form.dataset["formKey"] || "", form.dataset["eventName"] || "", values, {
        hostname: location.hostname,
        fetchImpl: (input, init) => fetch(input, init),
        attempt,
        ctx: { formStartedAt: startedAt, now: Date.now(), pageUrl: location.href, search: location.search, referrer: document.referrer },
      });
      submit.disabled = false;
      if (result.kind === "success") {
        if (form.dataset["successType"] === "redirect" && form.dataset["successValue"]) {
          location.assign(form.dataset["successValue"]);
          return;
        }
        form.reset();
        say(form.dataset["successValue"] || "Thank you! We will be in touch shortly!", "ok");
        return;
      }
      if (result.kind === "invalid") say("Please check the form, or call", "error", true);
      else if (result.kind === "rate_limited") say("Please wait a moment and try again, or call", "error", true);
      else if (result.kind === "not_sent") say("This preview cannot send the form. Please call", "info", true);
      else say("We could not confirm that message. Please call", "error", true);
    });
  });
</script>
