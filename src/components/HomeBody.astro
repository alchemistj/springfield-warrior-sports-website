---
import { site } from "../data/site";
import { media } from "../lib/media";
import ReviewBand from "./ReviewBand.astro";

const obstacle = media("media/2025-12-SpringField-indoor-obstacle.pair.webp");
const everyday = media("media/2023-03-everyday-warrior.webp");
const cards = [
  {
    slot: "classes",
    file: "media/2023-03-classes.webp",
    title: "Classes and Activities for Kids",
    body: [
      "Springfield Warrior Sports offers kids classes that help build strength, balance, and coordination.",
      "With a variety of obstacles and challenges, your child will never get bored.",
      "Plus, they can have a lot of fun while working up a sweat!",
    ],
    extra: "Sign up for a trial class today, your young warrior will thank you!",
    href: "/kids-classes/",
    label: "VIEW OUR KIDS CLASSES AND ACTIVITIES HERE",
  },
  {
    slot: "train",
    file: "media/2023-03-train.webp",
    title: "Train Like a Ninja Warrior",
    body: [
      "Our adult classes are designed for all fitness levels, so whether you are a beginner or an experienced athlete, there is something for you.",
      "The obstacles and challenges are constantly changing, so you never get bored.",
      "And because the focus is on having fun, you will be encouraged to push yourself further than you ever thought possible.",
    ],
    href: "/fitness-classes/",
    label: "CHECK OUT OUR NINJA FITNESS CLASSES HERE",
  },
  {
    slot: "bday",
    file: "media/2023-03-birthday.webp",
    title: "Birthday Parties",
    body: [
      "Warrior Sports offers the best party experience in Springfield MO!",
      "Whether it’s for your child’s birthday or for a special group event, we take care of all the planning and clean up, so you can relax and enjoy your special day.",
      "Parties are 1.5 hours long, and include an hour of gym and party room time and an obstacle course or another chosen activity facilitated by our Crew.",
    ],
    href: "/birthday-parties/",
    label: "BIRTHDAY PARTIES IN SPRINGFIELD MO DETAILS",
  },
  {
    slot: "parkour",
    file: "media/2023-04-Parkour-Gym-Parkour-Classes-Banner.webp",
    title: "Parkour",
    body: [
      "Springfield Warrior Sports is the premier destination for parkour training!",
      "Our expert instructors will guide you through every obstacle course, helping you to improve your physical skills and also boosting your confidence.",
      "With a focus on strength, agility, speed, balance, and self-confidence, our open gym time and classes can help you reach your potential both inside and out of the gym.",
    ],
    extra: "parkour",
    href: "/parkour/",
    label: "CHECK OUT OUR PARKOUR OFFERINGS HERE",
  },
  {
    slot: "home",
    file: "media/2024-02-kids-classes.webp",
    title: "Homeschool Ninja Warrior Classes",
    body: [
      "Keep your homeschooler active, strong, and having a blast!",
      "Our homeschool classes are a high-energy way for kids to build strength and confidence while tackling fun obstacle course challenges.",
      "With plenty of movement, excitement, and opportunities to connect with other homeschoolers, this is PE like never before!",
    ],
    href: "/homeschool-sports-and-classes-springfield-mo/",
    label: "HOMESCHOOL CLASSES BY SWS",
  },
  {
    slot: "pt",
    file: "media/2025-06-the-Best-Gyms-in-Springfield-MO.webp",
    title: "Personal Training",
    body: [
      "Personal training for kids, teens, and adults.",
      "Find a coach who gets your goals and your lifestyle.",
      "Build strength and confidence while progressing in your sport—or just moving better in everyday life.",
      "Schedule your free consultation today!",
    ],
    href: "/personal-training/",
    label: "PERSONAL TRAINING AT WARRIOR SPORTS",
  },
];
const shots = Object.fromEntries(cards.map((card) => [card.file, media(card.file)]));
const rangeRe = /(\d{1,2}(?::\d{2})?(?:am|pm)?)\s*[-–]\s*(\d{1,2}(?::\d{2})?(?:am|pm)?)/gi;
function rangeParts(text: string) {
  const bits: { range: boolean; text: string }[] = [];
  let cursor = 0;
  for (const match of text.matchAll(rangeRe)) {
    const index = match.index ?? 0;
    if (index > cursor) bits.push({ range: false, text: text.slice(cursor, index) });
    bits.push({ range: true, text: match[0] });
    cursor = index + match[0].length;
  }
  if (cursor < text.length || bits.length === 0) bits.push({ range: false, text: text.slice(cursor) });
  return bits;
}
const hours = [
  "Monday: 12pm-6pm",
  "Tuesday: 3pm-5:30pm",
  "Wednesday: 12pm-5:30pm",
  "Thursday: 3pm-6pm",
  "Friday: 12pm-6pm",
  "Saturday: 2pm-6pm",
  "Sunday: Private Parties and Group Events by Appointment",
  "Preschool hours: Tuesday mornings from 9:30am-11:30am",
];
const logos = [
  ["media/2023-03-csna-logo.webp", "csna"],
  ["media/2023-03-hulafrog-mustloved.webp", "hula"],
  ["media/2023-03-national-ninja-league_03.webp", "ninja"],
  ["media/2023-03-godfatherpizaa.webp", "pizza"],
  ["media/2023-03-417local.webp", "local"],
  ["media/2023-03-frictionLabs.webp", "friction"],
] as const;
const jennifer = {
  text: "We had our son’s 10th birthday here. All of the kids had a great time. They set up an obstacle course for the kids. They loved the whole experience. The favorite was the curved wall to run up. That was everyone’s challenge for the night. We will be visiting again for sure.",
  by: "- Jennifer L.",
};
const lee = {
  text: "My daughter started training here 3 years ago at 8, and she still loves it!! Owner and coaching staff are all super encouraging. We live an hour away but make the drive twice a week as often as possible. Training here has not only helped her get stronger physically but increased her confidence in general. Anything that makes kids want to challenge themselves to get better and better is worth it!",
  by: "- Lee C.",
};
---

<section class="home-ready" id="open-gym">
  <div class="wrap home-ready-grid">
    <div class="home-ready-photos">
      <img loading="lazy" decoding="async" src={obstacle.src} alt="Springfield indoor obstacle gym" width={obstacle.width} height={obstacle.height} />
    </div>
    <div class="home-ready-copy">
      <h2>Get Ready to</h2>
      <h3>Reach Your Fun and Fitness Goals with Springfield Warrior Sports</h3>
      <p>We believe in results and that a life of health and fitness shouldn’t be boring. Our indoor obstacle training facility is like a fitness playground for all ages.</p>
      <p class="aside">The best part?</p>
      <p>You don’t need any previous experience or knowledge — all you need is the determination to reach your fitness goals!</p>
      <h3 class="hours-title">Open Gym Hours</h3>
      <ul class="hours">
        {hours.map((line) => {
          const split = line.indexOf(": ");
          const label = split === -1 ? line : line.slice(0, split + 1);
          const when = split === -1 ? "" : line.slice(split + 1);
          return (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 5h-2v6l5 3 1-1.7-4-2.3z" /></svg>
              <span class="slot"><span class="label">{label}</span>{when && <span class="when"> {rangeParts(when).map((bit) => bit.range ? <span class="range">{bit.text}</span> : bit.text)}</span>}</span>
            </li>
          );
        })}
      </ul>
      <p>(see below for our class hours and times, which vary slightly from the open gym hours above.)</p>
    </div>
  </div>
</section>

<section class="home-offers">
  <div class="wrap">
    <h2 class="offers-title">Springfield's Best Obstacle Training Gym</h2>
    <div class="offer-list">
      {cards.map((card) => {
        const shot = shots[card.file];
        return (
          <article class:list={["offer-card", `offer-${card.slot}`]}>
            {shot && <img loading="lazy" decoding="async" src={shot.src} alt="" width={shot.width} height={shot.height} />}
            <div class="offer-copy">
              <h3>{card.title}</h3>
              {card.body.map((para) => <p>{para}</p>)}
              {card.extra === "parkour" && (
                <p>Parkour classes are <span class="mid">currently unavailable</span>, but Open Gym sessions are available now — your first visit is just $10.</p>
              )}
              {card.extra && card.extra !== "parkour" && <p>{card.extra}</p>}
            </div>
            <p class="btn-row"><a class="btn" href={card.href}>{card.label}</a></p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<ReviewBand title="Client Testimonials" sub="What Our Clients Say" text={jennifer.text} by={jennifer.by} />

<section class="warrior">
  <div class="wrap warrior-grid">
    <h2>Be an Everyday Warrior!</h2>
    <img class="warrior-photo" loading="lazy" decoding="async" src={everyday.src} alt="Springfield Warrior Sports coaches" width={everyday.width} height={everyday.height} />
    <div class="warrior-copy">
      <p>At Springfield Warrior Sports, we know that you want to be fit, healthy, and STRONGER to take on every obstacle.</p>
      <p>Our accomplished and award-winning crew is here to help you find your strength and enjoy your workouts again.</p>
      <p>If you’re looking for a unique and fun way to get active, you can come in at any time during our open hours and have a great time getting fit!</p>
      <p>$15 per person ages 5+ during open gym hours. Stay as long as you would like.</p>
      <p class="warrior-actions">
        <a class="btn" href="https://square.link/u/GmmQ7iuL">TRY OPEN GYM FOR $10</a>
        <a class="btn warrior-phone" href={site.phone.tel}>{site.phone.display}</a>
      </p>
    </div>
  </div>
</section>

<ReviewBand text={lee.text} by={lee.by} />

<section class="partner-band" aria-label="Partners">
  <div class="partner-row">
    {
      logos.map(([file, name]) => {
        const img = media(file);
        return <img loading="lazy" decoding="async" class={name} src={img.src} alt="" width={img.width} height={img.height} />;
      })
    }
  </div>
</section>

<style>
  .home-ready {
    padding: 28px 0 12px;
  }
  .home-ready-grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .home-ready-copy { order: 1; }
  .home-ready-photos { order: 2; }
  .home-ready-photos img {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-ready-copy h2,
  .warrior h2 {
    margin: 0 0 8px;
    color: var(--color-ws-red);
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 32px;
    font-weight: 900;
    line-height: 1.1;
  }
  .home-ready-copy h3 {
    margin: 0 0 12px;
    color: #000;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.3;
  }
  .home-ready-copy p,
  .warrior-copy p,
  .offer-copy p {
    margin: 0 0 12px;
    font-weight: 400;
  }
  .home-ready-copy p.aside {
    margin-bottom: 4px;
    color: rgb(40, 82, 118);
    font-weight: 600;
  }
  .home-ready-copy h3.hours-title {
    margin: 16px 0 10px;
    color: #d6352f;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.15;
    text-transform: none;
  }
  .hours {
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
  }
  .hours li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0 0 4px;
  }
  .hours svg {
    flex: 0 0 18px;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    fill: #d6352f;
  }
  .hours .slot {
    color: #6a6b6c;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.35;
  }
  .hours .when { font-weight: 400; }

  .home-offers {
    background: var(--color-ws-blue-dark);
    padding: 28px 0 32px;
  }
  .offers-title {
    margin: 0 0 16px;
    color: #fff;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 28px;
    font-weight: 900;
    line-height: 1.2;
    text-align: center;
  }
  .offer-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .offer-card {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 220px auto auto;
    gap: 0;
    align-items: stretch;
    background: #fff;
    color: #000;
    min-width: 0;
  }
  .offer-card img {
    display: block;
    grid-column: 1;
    grid-row: 1;
    width: 100%;
    height: 220px;
    min-height: 0;
    object-fit: cover;
    object-position: center 30%;
    background: #fff;
  }
  .offer-card.offer-classes img { object-position: center 26%; }
  .offer-card.offer-train img { object-position: center 16%; }
  .offer-card.offer-bday img { object-position: center 6%; }
  .offer-card.offer-parkour img { object-position: left 40%; }
  .offer-card.offer-home img { object-position: center 42%; }
  .offer-card.offer-pt img { object-position: 20% 26%; }
  .offer-copy {
    display: flex;
    flex-direction: column;
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
    height: auto;
    padding: 16px 16px 8px;
  }
  .offer-copy h3 {
    margin: 0 0 8px;
    color: #285276;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.2;
  }
  .offer-copy p { color: #000; font-size: 16px; line-height: 1.45; }
  .offer-copy .mid { font-weight: 600; }
  .offer-card .btn,
  .warrior-actions .btn {
    width: 100%;
    max-width: 100%;
    min-height: 48px;
    padding: 10px 16px;
    white-space: normal;
    border-radius: 28px;
    line-height: 1.25;
  }
  .btn-row {
    grid-column: 1;
    grid-row: 3;
    margin: 0;
    padding: 4px 16px 16px;
  }
  @media (min-width: 641px) {
    .offer-card {
      grid-template-columns: 360px minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      min-height: 409px;
    }
    .offer-card img {
      grid-row: 1 / -1;
      height: 100%;
      min-height: 0;
    }
    .offer-copy {
      grid-column: 2;
      grid-row: 1;
      padding: 20px 22px 8px;
    }
    .btn-row {
      grid-column: 2;
      grid-row: 2;
      padding: 0 22px 16px;
    }
    .offer-card .btn { width: auto; }
    .offer-card.offer-parkour img { object-position: 12% 40%; }
    .offer-card.offer-pt img { object-position: 55% 14%; }
    .offer-card.offer-train img { object-position: center 18%; }
    .offer-card.offer-classes img { object-position: center 24%; }
    .offer-card.offer-bday img { object-position: 78% 38%; }
    .offer-card.offer-home img { object-position: center 46%; }
  }

  .warrior {
    background: #fff;
    padding: 32px 0 12px;
  }
  .warrior-grid {
    display: grid;
    gap: 8px;
  }
  .warrior h2 { order: 1; }
  .warrior-photo {
    order: 2;
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: #fff;
  }
  .warrior-copy { order: 3; }
  .warrior-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin: 4px 0 0;
  }
  .warrior-phone { background: var(--color-ws-red); color: #fff; }

  .partner-band { background: rgb(40, 82, 118); }
  .partner-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 36px 0 48px;
  }
  .partner-row img { height: auto; object-fit: contain; }
  .csna { width: 156px; }
  .hula, .ninja { width: 121px; }
  .pizza { width: 148px; }
  .local { width: 184px; }
  .friction { width: 156px; }

  @media (min-width: 800px) {
    .home-ready { padding: 40px 0 20px; }
    .home-ready-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      column-gap: 28px;
      align-items: start;
    }
    .home-ready-copy,
    .home-ready-photos { order: 0; }
    .home-ready-copy h2 { font-size: 40px; }
    .home-ready-copy h3.hours-title { font-size: 30px; font-weight: 800; color: #d6352f; }
    .home-ready-copy h3 { font-size: 24px; }
    .offers-title { font-size: 36px; margin-bottom: 18px; }
    .offer-copy h3 { font-size: 24px; }
    .warrior-actions .btn { width: auto; }
    .warrior { padding: 48px 0 20px; }
    .warrior-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
      column-gap: 28px;
      align-items: center;
    }
    .warrior-actions { flex-wrap: nowrap; }
    .warrior h2 {
      grid-column: 1;
      grid-row: 1;
      order: 0;
      font-size: 40px;
    }
    .warrior-copy { grid-column: 1; grid-row: 2; order: 0; }
    .warrior-photo {
      grid-column: 2;
      grid-row: 1 / span 2;
      order: 0;
      align-self: stretch;
      height: 100%;
      object-fit: cover;
    }
    .home-ready-photos img { height: 100%; object-fit: cover; }
    .partner-row {
      flex-direction: row;
      justify-content: space-between;
      width: min(900px, calc(100% - 48px));
      margin: 0 auto;
      padding: 36px 0;
    }
    .csna, .local { width: 140px; }
    .hula, .ninja, .pizza, .friction { width: 120px; }
  }
</style>
