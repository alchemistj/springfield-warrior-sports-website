---
import quoteIcon from "../assets/media/2023-03-qoute-icon.webp";

interface Props {
  text: string;
  by: string;
  title?: string;
  sub?: string;
  continued?: boolean;
}
const { text, by, title, sub, continued = false } = Astro.props;
const icon = quoteIcon as { src: string; width: number; height: number };
---

<section class:list={["review-band", { continued }]}>
  <div class="review-inner">
    {(title || sub) && (
      <p class="review-label">
        {title}
        {sub && <span>{sub}</span>}
      </p>
    )}
    <blockquote>
      <img class="quote-mark" src={icon.src} alt="" width="42" height="42" />
      <p>{text}</p>
      <p class="review-by">{by}</p>
    </blockquote>
  </div>
</section>

<style>
  .review-band {
    background: #e5eaed;
    padding: 36px 0;
  }
  .review-band.continued { padding-top: 8px; }
  .review-inner {
    box-sizing: border-box;
    width: min(var(--content-max), calc(100% - var(--content-pad) * 2));
    margin: 0 auto;
  }
  .review-label {
    margin: 0 0 12px;
    color: #5c6570;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-align: center;
  }
  .review-label span { display: block; font-weight: 600; }
  blockquote { margin: 0; }
  .quote-mark { display: block; width: 42px; height: 42px; margin: 0 0 12px; }
  p {
    margin: 0;
    color: #171716;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 17px;
    line-height: 1.55;
  }
  .review-by {
    margin-top: 12px;
    color: #d6352f;
    font-weight: 800;
  }
</style>
