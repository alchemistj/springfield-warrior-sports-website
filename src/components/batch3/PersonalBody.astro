---
import type { EventForm } from "../../data/events";
import FactIcon from "../batch2/FactIcon.astro";
import LeadForm from "../LeadForm.astro";
import { media } from "../batch2/media";
import pricingBg from "../../assets/media/2023-03-Pricing-and-Schedule.webp";

interface Props {
  event: EventForm;
}
const { event } = Astro.props;
const heroShot = media("media/2025-08-Warrior-Sports-Personal-Training.webp");
const cards = [
  ["media/2025-08-Unconventional-by-Design.webp", "Unconventional by Design", "We use obstacle training, resistance bands, parkour-inspired drills, and reactive movement. These methods naturally demand personalization. Every session is a custom experience."],
  ["media/2025-08-Stronger-and-Smarter-training.webp", "Stronger and Smarter", "This isn’t just about muscles. It’s about moving with confidence. Our training boosts body awareness, mind-muscle connection, and coordination, helping you move better in daily life."],
  ["media/2025-08-Emotionally-Intelligent-Coaching.webp", "Emotionally Intelligent Coaching", "We meet you where you are, without shame or performance pressure. Whether you’re just starting or getting unstuck, we help you rediscover joy in movement."],
] as const;
const trainers = [
  ["media/2025-08-sarah-wilder-img.webp", "Sarah Wilder", "– Women’s Confidence Coach", "Helps women, especially moms, feel strong again in bodies that have carried so much.", "“I focus on helping you feel powerful before you even pick up a weight.”"],
  ["media/2025-08-Jacob-Winter-img.webp", "Jacob Winter", "– Strength, Weight Loss and Conditioning", "Great for weight loss, functional strength, and rebuilding consistency.", "“We build wins you can feel without judgment or pressure.”"],
  ["media/2025-08-jonny-wilder-img.webp", "Jonny Wilder", "– Ninja and Competitive Obstacle Training", "Perfect for teens, adventurous adults, or athletes seeking confidence and agility.", "“Training should be fun. That’s where confidence begins.”"],
] as const;
const how = media("media/2025-08-Warrior-Sports-training.jpg");
const quote = media("media/2023-03-qoute-icon.webp");
const pricing = typeof pricingBg === "string" ? pricingBg : pricingBg.src;
const steps = [
  "Contact us and share your story—goals, concerns, struggles",
  "We’ll reach out and get you locked in",
  "Try a session personalized to your pace and strength",
  "Decide from there if you want to continue",
];
---

<section class="b3 pt-intro">
  <div class="b3-wrap b3-split">
    <div>
      <h2>Not Your Typical Gym.<br />Not Your Typical Trainer.</h2>
      <p>If you’ve ever felt like fitness wasn’t made for you, you’re in the right place.</p>
      <p>We don’t (necessarily) do treadmills or machine circuits. We do movement that makes you stronger, sharper, and more confident…your way.</p>
      <p class="pt-note">Because when training is rooted in curiosity and connection, not comparison, you show up differently. We work with clients from across Springfield. Battlefield to Sunshine and everywhere in between, because personalized training should feel close to home.</p>
      <a class="b3-btn w800 block" href="#lead-form">Contact our personal trainers</a>
    </div>
    {heroShot.src && <img src={heroShot.src} alt="" width={heroShot.width} height={heroShot.height} loading="lazy" decoding="async" />}
  </div>
</section>

<section class="b3 b3-grey pt-why">
  <div class="b3-wrap">
    <h2 class="w920"><span>Why Warrior Sports</span> <span>Personal Training Works</span></h2>
    <p>At Warrior Sports, personal training is based on partnerships.</p>
    <p>It’s a conversation and a challenge all rolled into one.</p>
    <p>Here’s how we’re different:</p>
    <div class="pt-cards">
      {cards.map(([file, title, body]) => {
        const img = media(file);
        return (
          <article>
            {img.src && <img src={img.src} alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />}
            <h4>{title}</h4>
            <p>{body}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="b3 b3-navyband pt-meet">
  <div class="b3-wrap">
    <h2>Meet Your Trainers</h2>
    <div class="pt-trainers">
      {trainers.map(([file, name, role, body, line]) => {
        const img = media(file);
        return (
          <article>
            {img.src && <img src={img.src} alt="" width={img.width} height={img.height} loading="lazy" decoding="async" />}
            <h4>{name}</h4>
            <p class="role">{role}</p>
            <p>{body}</p>
            <p class="quote">{line}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>

<section class="b3 b3-ice pt-how">
  <div class="b3-wrap b3-split">
    {how.src && <img src={how.src} alt="" width={how.width} height={how.height} loading="lazy" decoding="async" />}
    <div>
      <h2>How It Works</h2>
      <ul class="b3-facts">
        {steps.map((step, index) => (
          <li><FactIcon name="arrow" /><span class={index === 1 ? "ink" : undefined}>{step}</span></li>
        ))}
      </ul>
      <a class="b3-btn w800 block" href="#lead-form">Contact our personal trainers</a>
    </div>
  </div>
</section>

<section class="b3 b3-grey pt-say">
  <div class="b3-wrap">
    <h2>What Our Clients Say</h2>
    <div class="pt-quotes">
      <blockquote>
        {quote.src && <img src={quote.src} alt="" width="65" height="65" />}
        <p>After losing some weight on my own, I hit a wall. Warrior Sports changed the game for me. My coach built a program just for me and held me accountable in a way that made me stronger, leaner, and more confident—not just physically, but mentally.</p>
        <p class="by">- Client</p>
      </blockquote>
      <blockquote>
        {quote.src && <img src={quote.src} alt="" width="65" height="65" />}
        <p>Over a year, I lost over 50 pounds, gained mobility and confidence, and competed in multiple obstacle races. Warrior Sports is family-friendly, fun, and motivating. My trainer, Jacob, made workouts fast, personal, and sustainable.</p>
        <p class="by">— Michael B.</p>
      </blockquote>
    </div>
  </div>
</section>

<section class="b3 b3-band pt-form" style={`background-image: url('${pricing}')`}>
  <div class="b3-wrap">
    <h2>Let’s Talk Strength…Your Version</h2>
    <h4>This isn’t about getting shredded or setting records.</h4>
    <h4>It’s about moving, healing, and growing in a way that actually fits your life.</h4>
    <div class="pt-form-card">
      <LeadForm event={event} />
    </div>
  </div>
</section>
