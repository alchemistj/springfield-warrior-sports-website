---
import { site } from "../../data/site";
import { media } from "../batch2/media";

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const photo = media("media/2023-03-everyday-warrior.webp");
const phone = site.phone.display;
const tel = site.phone.tel;

const pages: Record<string, { title: string; h: number; wide?: boolean; photo: boolean }> = {
  registered: { title: "We Received Those Details, Thank You!", h: 477, photo: true },
  "registered-for-csna-competition": { title: "We Received Those Details, Thank You!", h: 465, wide: true, photo: false },
  "registered-for-day-camps": { title: "We Received Those Details, Thank You!", h: 545, photo: true },
  "registered-for-summer-fun-competition": { title: "We Received Those Details, Thank You!", h: 505, photo: true },
  "registered-for-wnl-competition": { title: "We Received Those Details, Thank You!", h: 477, photo: true },
  "thank-you-for-your-feedback": { title: "Thank You for Your Feedback!", h: 561, photo: true },
};
const page = pages[slug];
if (!page) throw new Error(`Unknown thank-you page ${slug}`);

const pay: Record<string, { href: string; tone: string }> = {
  registered: { href: "https://springfield-warrior-sports.square.site/", tone: "red" },
  "registered-for-wnl-competition": { href: "https://springfield-warrior-sports.square.site/", tone: "red" },
  "registered-for-csna-competition": {
    href: "https://checkout.square.site/merchant/MLXTPBS97BGYV/checkout/4AIX4JFZMCKCVNT35N7AHFV7",
    tone: "blue",
  },
  "registered-for-summer-fun-competition": {
    href: "https://springfield-warrior-sports.square.site/product/summer-fun-competition-fundraiser-/217",
    tone: "blue",
  },
  "registered-for-day-camps": { href: "https://springfield-warrior-sports-102788.square.site/", tone: "red" },
};
const link = pay[slug] ?? { href: "", tone: "red" };
---

<section
  class:list={["b4-thanks", { plain: !page.photo, wide: page.wide, feedback: slug === "thank-you-for-your-feedback" }]}
  style={page.photo ? `--thanks-h:${page.h}px;--thanks-photo:url('${photo.src}')` : undefined}
>
  <div class="col">
    <h2>{page.title}</h2>
    {
      slug === "registered-for-day-camps" ? (
        <>
          <p class="pay"><a href={link.href}>{`Click here to finalize the registration with your payment.`}</a></p>
          <p>The link above has a few "product" options, simply select the appropriate camp you are attending, enter your payment information, and done!</p>
          <p>
            If you encounter any problems or have any questions, please call or text us at <a class="red" href={tel}>{phone}</a>.
          </p>
        </>
      ) : slug === "registered-for-summer-fun-competition" ? (
        <>
          <p>
            Click here to finalize the registration with your payment, <a class={link.tone} href={link.href}>{link.href}</a>
          </p>
          <p>
            If you encounter any problems or have any questions, please call or text us at <a class="red" href={tel}>{phone}</a>.
          </p>
        </>
      ) : slug === "thank-you-for-your-feedback" ? (
        <p>
          Thank you for your feedback! We read and respond to each message and will be in touch typically within the same business day.<br /><br />
          If you need to contact us immediately, call us at <a class="red" href={tel}>(417)894-7319</a>.<br /><br />
          Thanks,<br /><br />
          Andy and the Warrior Sports Team
        </p>
      ) : (
        <p>
          Click here to finalize the registration with your payment, <a class={link.tone} href={link.href}>{link.href}</a><br /><br />
          If you encounter any problems or have any questions, please call or text us at <a class="red" href={tel}>{phone}</a>.
        </p>
      )
    }
    {page.photo && <img class="shot" src={photo.src} alt="" width="350" height="312" />}
  </div>
</section>
