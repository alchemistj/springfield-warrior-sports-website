---
import { mainNav, utilityNav } from "../data/site";
import { media } from "../lib/media";

interface Props {
  current: string;
}
const { current } = Astro.props;
const logo = media("media/2023-03-SpringField-Warrior-Logo.webp");

const linkProps = (item: { path: string; external?: boolean }) =>
  item.external ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<header class="site-header" data-header>
  <div class="util-bar">
    <nav class="bar util-links" aria-label="Utility">
      {
        utilityNav.map((item) => (
          <a href={item.path} aria-current={item.path === current ? "page" : undefined} {...linkProps(item)}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="main-bar">
    <div class="bar main-inner">
      <a class="logo-link" href="/" aria-label="Springfield Warrior Sports, home">
        <img src={logo.src} alt="" width="203" height="59" />
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu" data-menu>
        <span class="sr-only">Menu</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" /></svg>
      </button>
      <nav id="site-menu" class="nav-links" data-nav aria-label="Primary">
        {
          mainNav.map((item) => (
            <a href={item.path} aria-current={item.path === current ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const button = header?.querySelector<HTMLButtonElement>("[data-menu]");
  if (header && button) {
    button.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      button.setAttribute("aria-expanded", open ? "true" : "false");
    });
    header.querySelectorAll("nav a").forEach((link) => {
      link.addEventListener("click", () => {
        header.classList.remove("is-open");
        button.setAttribute("aria-expanded", "false");
      });
    });
    let last = window.scrollY;
    window.addEventListener(
      "scroll",
      () => {
        const y = window.scrollY;
        if (!header.classList.contains("is-open") && y > last && y > 80) header.classList.add("is-hidden");
        else header.classList.remove("is-hidden");
        last = y;
      },
      { passive: true },
    );
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: #fff;
    transform: translateY(0);
    transition: transform 0.2s ease;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .util-bar,
  .main-bar {
    position: relative;
    background: transparent;
  }
  .util-bar::before,
  .main-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .util-bar::before { background: #000; }
  .main-bar::before { background: #285276; }
  .util-links { box-sizing: border-box; }
  .bar {
    position: relative;
    z-index: 1;
    width: min(1150px, 100%);
    margin: 0 auto;
  }
  .util-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 11px 0;
  }
  .util-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 28px;
    color: #fff;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: 0;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }
  .util-links a:nth-child(1) { width: 70px; margin-right: 20px; }
  .util-links a:nth-child(2) { width: 51px; margin-right: 20px; }
  .util-links a:nth-child(3) { width: 133px; }
  .main-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    padding: 20px 16px 20px 20px;
  }
  .logo-link {
    display: flex;
    flex: 0 0 auto;
    line-height: 0;
  }
  .logo-link img {
    width: 203px;
    height: 59px;
    max-width: none;
    object-fit: contain;
  }
  .menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
  }
  .menu-btn svg {
    width: 20px;
    height: 20px;
    fill: #fff;
  }
  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 2;
    flex-direction: column;
    gap: 2px;
    padding: 8px 12px 16px;
    background: #285276;
  }
  .site-header.is-open .nav-links { display: flex; }
  .nav-links a {
    display: flex;
    align-items: center;
    min-height: 48px;
    color: #fff;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    text-transform: uppercase;
  }
  .nav-links a[aria-current="page"],
  .util-links a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 1024px) {
    .util-links {
      justify-content: flex-end;
      align-items: center;
      height: 46px;
      padding: 0 30px;
    }
    .util-links a:nth-child(1) { margin-right: 25px; }
    .util-links a:nth-child(2) { margin-right: 24px; }
    .main-inner {
      height: 93px;
      padding: 0 26px 0 20px;
    }
    .menu-btn { display: none; }
    .nav-links {
      display: flex;
      position: static;
      flex-direction: row;
      align-items: center;
      gap: 12px;
      margin-left: auto;
      padding: 0;
      background: transparent;
    }
    .nav-links a {
      box-sizing: border-box;
      height: 32px;
      min-height: 0;
      padding: 0;
      font-size: 16px;
      line-height: 32px;
      white-space: nowrap;
    }
    .nav-links a:nth-child(1) { width: 120px; }
    .nav-links a:nth-child(2) { width: 97px; }
    .nav-links a:nth-child(3) { width: 116px; }
    .nav-links a:nth-child(4) { width: 142px; }
    .nav-links a:nth-child(5) { width: 158px; }
    .nav-links a:nth-child(6) { width: 126px; }
  }
</style>
