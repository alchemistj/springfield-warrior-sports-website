---
import { footerLinks, site } from "../data/site";

const images = import.meta.glob("../assets/media/2023-03-SWS-logo-footer.webp", {
  eager: true,
  import: "default",
}) as Record<string, { src: string; width: number; height: number } | string>;
const logo = images["../assets/media/2023-03-SWS-logo-footer.webp"];
const logoSrc = typeof logo === "string" ? logo : logo?.src;
---

<footer class="site-footer">
  <div class="foot">
    <div class="brand">
      {logoSrc && <img src={logoSrc} alt="" width="266" height="76" />}
      <p>Our accomplished and award winning Crew are here to help you find your strength and enjoy your workouts.</p>
      <div class="socials">
        <a class="soc" href={site.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1z" /></svg>
        </a>
        <a class="soc" href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8zM17.4 6.6a1 1 0 1 1-1 1 1 1 0 0 1 1-1z" /></svg>
        </a>
      </div>
    </div>
    <div>
      <p class="foot-label">Contact</p>
      <ul class="foot-list">
        <li>
          <svg viewBox="0 0 384 512" aria-hidden="true"><path d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z" /></svg>
          <span class="line">{site.address.display}</span>
        </li>
        <li>
          <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z" /></svg>
          <span class="line"><a href={site.phone.tel}>{site.phone.display}</a></span>
        </li>
        <li>
          <svg viewBox="0 0 512 512" aria-hidden="true"><path d="M502.3 190.8c3.9-3.1 9.7-.2 9.7 4.7V400c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V195.6c0-5 5.7-7.8 9.7-4.7 22.4 17.4 52.1 39.5 154.1 113.6 21.1 15.4 56.7 47.8 92.2 47.6 35.7.3 72-32.8 92.3-47.6 102-74.1 131.6-96.3 154-113.7zM256 320c23.2.4 56.6-29.2 73.4-41.4 132.7-96.3 142.8-104.7 173.4-128.7 5.8-4.5 9.2-11.5 9.2-18.9v-19c0-26.5-21.5-48-48-48H48C21.5 64 0 85.5 0 112v19c0 7.4 3.4 14.3 9.2 18.9 30.6 23.9 40.7 32.4 173.4 128.7 16.8 12.2 50.2 41.8 73.4 41.4z" /></svg>
          <span class="line"><a href={`mailto:${site.email}`}>{site.email}</a></span>
        </li>
      </ul>
    </div>
    <div>
      <p class="foot-label">Quick Links</p>
      <ul class="foot-links">
        {footerLinks.map((item) => (
          <li><a href={item.path}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="copy-bar">
    <p class="copy-wide">© Copyright 2026 &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Springfield Warrior Sports &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;All Rights Reserved.</p>
    <p class="copy-line">© Copyright 2026</p>
    <p class="copy-line">Springfield Warrior Sports</p>
    <p class="copy-line">All Rights Reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #fff;
    color: #333;
    padding-top: 30px;
  }
  .foot {
    display: grid;
    gap: 22px;
    width: min(1110px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 18px;
  }
  :global(.page-home) .foot,
  :global(.page-about) .foot {
    padding-bottom: 84px;
  }
  .brand img {
    width: 266px;
    height: 76px;
    max-width: none;
    margin-bottom: 12px;
    object-fit: contain;
  }
  .brand p {
    width: 100%;
    max-width: 354px;
    margin: 0 0 16px;
    color: #333;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }
  .socials {
    display: flex;
    gap: 7px;
    margin-left: 6px;
  }
  .soc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #db3a34;
    color: #fff;
  }
  .soc svg {
    width: 17px;
    height: 17px;
    fill: #fff;
  }
  .foot-label {
    margin: 0 0 14px;
    color: #285276;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 2px;
    line-height: 28px;
    text-transform: uppercase;
  }
  .foot-list,
  .foot-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot-list {
    padding-left: 11px;
  }
  .foot-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0 0 12px;
    color: #333;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }
  .foot-list svg {
    flex: 0 0 auto;
    box-sizing: content-box;
    width: 16px;
    height: 16px;
    margin-top: 0;
    padding-top: 5px;
    fill: rgb(219, 58, 52);
  }
  .line {
    display: inline-block;
  }
  .foot-list a,
  .foot-links a {
    color: #333;
    font-weight: 400;
    text-decoration: none;
    background: transparent;
  }
  .foot-links li {
    display: block;
    margin: 0 0 2px;
    color: #333;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }
  .foot-links a {
    display: inline;
    font-size: 16px;
  }
  .copy-bar {
    position: relative;
    background: transparent;
    color: #fff;
    padding: 20px 0;
  }
  .copy-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
  }
  .copy-bar p {
    position: relative;
    z-index: 1;
    width: min(1110px, calc(100% - 40px));
    margin: 0 auto;
    padding: 0;
    color: #fff;
    font-family: Epilogue, Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 20px;
    text-align: center;
  }
  .copy-wide { display: none; }
  @media (min-width: 800px) {
    .site-footer { padding-top: 40px; }
    .foot {
      grid-template-columns: 354px 353px 301px;
      column-gap: 51px;
      align-items: start;
    }
    .copy-bar { padding: 21px 0 20px; }
    .copy-bar p.copy-wide {
      display: block;
      font-size: 14px;
      padding: 0;
      letter-spacing: 2px;
      line-height: 24px;
    }
    .copy-line { display: none; }
  }
</style>
