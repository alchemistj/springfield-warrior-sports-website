---
import { footerClasses, footerEvents, footerLinks, site } from "../data/site";
import { city } from "../data/cityConfig";

const images = import.meta.glob("../assets/media/2023-03-SWS-logo-footer.webp", {
  eager: true,
  import: "default",
}) as Record<string, { src: string; width: number; height: number } | string>;
const logo = images["../assets/media/2023-03-SWS-logo-footer.webp"];
const logoSrc = typeof logo === "string" ? logo : logo?.src;
const hourLines = [...site.hours.map((row) => row.text), site.sundayNote, site.preschoolNote];
---

<footer class="site-footer">
  <div class="foot">
    <div>
      <h2>Springfield Warrior Sports</h2>
      {logoSrc && <img src={logoSrc} alt="" width="220" height="63" />}
      <p class="desc">Our accomplished and award winning Crew are here to help you find your strength and enjoy your workouts.</p>
      <div class="socials">
        <a class="soc" href={site.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1z" /></svg>
        </a>
        <a class="soc" href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8zM17.4 6.6a1 1 0 1 1-1 1 1 1 0 0 1 1-1z" /></svg>
        </a>
      </div>
      <ul class="foot-links pages">
        {footerLinks.map((item) => (
          <li><a href={item.path}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Classes</h2>
      <ul class="foot-links">
        {footerClasses.map((item) => (
          <li><a href={item.path}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Events</h2>
      <ul class="foot-links">
        {footerEvents.map((item) => (
          <li><a href={item.path}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2>Visit</h2>
      <p><span class="lab">Phone</span> <a href={site.phone.tel}>{site.phone.display}</a></p>
      <p><span class="lab">Email</span> <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p class="addr"><span class="lab">Address</span> {site.address.display}</p>
      <p><span class="lab">Hours</span></p>
      <ul class="hours">
        {hourLines.map((line) => <li>{line}</li>)}
      </ul>
      <p><span class="lab">Service area</span> {city.serviceArea.join(", ")}</p>
    </div>
  </div>
  <div class="copy-bar">
    <p>© Copyright 2026 Springfield Warrior Sports All Rights Reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #111;
    color: #fff;
    padding-top: 36px;
  }
  .foot {
    display: grid;
    gap: 28px;
    box-sizing: border-box;
    width: min(var(--content-max), calc(100% - var(--content-pad) * 2));
    margin: 0 auto;
    padding-bottom: 28px;
  }
  h2 {
    margin: 0 0 12px;
    color: #fff;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.3;
    text-transform: none;
  }
  img {
    display: block;
    width: 200px;
    height: auto;
    margin: 0 0 12px;
  }
  .desc, p, li, a {
    color: #fff;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.45;
  }
  .desc { margin: 0 0 12px; }
  p { margin: 0 0 10px; }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; }
  .lab {
    display: block;
    color: #f0c7c5;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .socials { display: flex; gap: 8px; margin: 0 0 14px; }
  .soc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #db3a34;
  }
  .soc svg { width: 16px; height: 16px; fill: #fff; }
  .foot-links, .hours {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .foot-links li, .hours li { margin: 0 0 6px; }
  .pages { margin-top: 4px; }
  .copy-bar {
    background: #000;
    padding: 16px 0;
  }
  .copy-bar p {
    width: min(var(--content-max), calc(100% - var(--content-pad) * 2));
    margin: 0 auto;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }
  @media (min-width: 900px) {
    .foot {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 20px;
      align-items: start;
    }
  }
  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: calc(var(--callbar-h) + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
