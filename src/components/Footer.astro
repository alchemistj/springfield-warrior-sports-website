---
import { footerLinks, site } from "../data/site";

const images = import.meta.glob("../assets/media/2023-03-SWS-logo-footer.webp", {
  eager: true,
  import: "default",
}) as Record<string, { src: string; width: number; height: number } | string>;
const logo = images["../assets/media/2023-03-SWS-logo-footer.webp"];
const logoSrc = typeof logo === "string" ? logo : logo?.src;
---

<footer class="site-footer">
  <div class="foot">
    <div class="brand">
      {logoSrc && <img src={logoSrc} alt="" width="266" height="76" />}
      <p>Our accomplished and award winning Crew are here to help you find your strength and enjoy your workouts.</p>
      <div class="socials">
        <a class="soc" href={site.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h3l1-3h-4V10c0-.6.4-1 1-1z" /></svg>
        </a>
        <a class="soc" href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm10 2H7a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm-5 3.2A3.8 3.8 0 1 1 8.2 12 3.8 3.8 0 0 1 12 8.2zm0 1.6A2.2 2.2 0 1 0 14.2 12 2.2 2.2 0 0 0 12 9.8zM17.4 6.6a1 1 0 1 1-1 1 1 1 0 0 1 1-1z" /></svg>
        </a>
      </div>
    </div>
    <div>
      <p class="foot-label">Contact</p>
      <ul class="foot-list">
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 14.5 9 2.5 2.5 0 0 1 12 11.5z" /></svg>
          <span class="line">{site.address.display}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11 11 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 7a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11 11 0 0 0 .6 3.6 1 1 0 0 1-.25 1z" /></svg>
          <span class="line"><a href={site.phone.tel}>{site.phone.display}</a></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm9 7L4 7v.2l8 5.2 8-5.2V7z" /></svg>
          <span class="line"><a href={`mailto:${site.email}`}>{site.email}</a></span>
        </li>
      </ul>
    </div>
    <div>
      <p class="foot-label">Quick Links</p>
      <ul class="foot-links">
        {footerLinks.map((item) => (
          <li><a href={item.path}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="copy-bar">
    <p class="copy-wide">© Copyright 2026 &nbsp;&nbsp; Springfield Warrior Sports &nbsp;&nbsp; All Rights Reserved.</p>
    <p class="copy-line">© Copyright 2026</p>
    <p class="copy-line">Springfield Warrior Sports</p>
    <p class="copy-line">All Rights Reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #fff;
    color: #333;
    padding-top: 28px;
  }
  .foot {
    display: grid;
    gap: 22px;
    width: min(1110px, calc(100% - 40px));
    margin: 0 auto;
    padding-bottom: 18px;
  }
  .brand img {
    width: 266px;
    height: 76px;
    max-width: none;
    margin-bottom: 12px;
    object-fit: contain;
  }
  .brand p {
    width: 100%;
    max-width: 354px;
    margin: 0 0 16px;
    color: #333;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }
  .socials {
    display: flex;
    gap: 13px;
    margin-left: 6px;
  }
  .soc {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #db3a34;
    color: #fff;
  }
  .soc svg {
    width: 17px;
    height: 17px;
    fill: #fff;
  }
  .foot-label {
    margin: 0 0 14px;
    color: #285276;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 2px;
    line-height: 28px;
    text-transform: uppercase;
  }
  .foot-list,
  .foot-links {
    margin: 0;
    padding: 0 0 0 11px;
    list-style: none;
  }
  .foot-list li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin: 0 0 12px;
    color: #333;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }
  .foot-list svg {
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
    margin-top: 2px;
    fill: rgb(219, 58, 52);
  }
  .line {
    display: inline-block;
  }
  .foot-list a,
  .foot-links a {
    color: #333;
    font-weight: 400;
    text-decoration: none;
    background: transparent;
  }
  .foot-links li {
    display: block;
    margin: 0 0 2px;
    color: #333;
    font-family: Muli, "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.5;
  }
  .foot-links a {
    display: inline;
    font-size: 16px;
  }
  .copy-bar {
    position: relative;
    background: transparent;
    color: #fff;
  }
  .copy-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #000;
  }
  .copy-bar p {
    position: relative;
    z-index: 1;
    width: min(1110px, calc(100% - 40px));
    margin: 0 auto;
    padding: 0;
    color: #fff;
    font-family: Epilogue, Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 20px;
    text-align: center;
  }
  .copy-wide { display: none; }
  @media (max-width: 799px) {
    .foot-links { padding-left: 0; }
    :global(.page-home) .site-footer,
    :global(.page-about) .site-footer { padding-top: 123px; }
  }
  @media (min-width: 800px) {
    :global(.page-home) .site-footer { padding-top: 111px; }
    :global(.page-about) .site-footer { padding-top: 115px; }
    .foot {
      grid-template-columns: 354px 353px 301px;
      column-gap: 51px;
      align-items: start;
    }
    .copy-bar p.copy-wide {
      display: block;
      font-size: 14px;
      padding: 0;
      letter-spacing: 2px;
      line-height: 24px;
    }
    .copy-line { display: none; }
  }
</style>
