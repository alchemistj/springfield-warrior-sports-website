---
import { site, stickyBar } from "../data/site";

const onPartyPage = Astro.url.pathname === stickyBar.bookPath;
const bookHref = onPartyPage ? stickyBar.formAnchor : stickyBar.bookPath;
---

<div class="call-bar" role="region" aria-label="Call or book a party">
  <div class="call-bar-row">
    <a class="cb-btn" href={site.phone.tel}>{stickyBar.callLabel}</a>
    <a class="cb-btn" href={bookHref}>{stickyBar.bookLabel}</a>
  </div>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    box-sizing: border-box;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .call-bar-row {
    display: flex;
    gap: 10px;
    padding: 8px 12px;
  }
  .cb-btn {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    border-radius: 999px;
    background: var(--color-ws-red);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  @media (min-width: 768px) {
    .call-bar {
      display: none;
    }
  }
</style>
