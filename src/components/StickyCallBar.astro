---
import { site, stickyBar } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const onContact = path === "/contact";
---

<div class="call-bar" role="region" aria-label="Call or contact Springfield Warrior Sports">
  <div class="call-bar-row">
    <a class="cb-btn cb-primary" href={site.phone.tel}>{stickyBar.callLabel}</a>
    {!onContact && <a class="cb-btn cb-secondary" href={stickyBar.contactPath}>{stickyBar.contactLabel}</a>}
  </div>
</div>

<style>
  .call-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    box-sizing: border-box;
    background: #fff;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .call-bar-row {
    display: flex;
    gap: 10px;
    padding: 8px 12px;
  }
  .cb-btn {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 48px;
    padding: 12px 22px;
    border-radius: 999px;
    font-family: Heebo, "Arial Narrow", sans-serif;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    white-space: normal;
  }
  .cb-primary {
    background: #d6352f;
    color: #fff;
  }
  .cb-secondary {
    background: transparent;
    color: #285276;
    box-shadow: inset 0 0 0 2px #285276;
  }
  @media (min-width: 768px) {
    .call-bar { display: none; }
  }
</style>
